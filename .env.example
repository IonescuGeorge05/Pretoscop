# Pretoscop environment. Copy to `.env` (never commit `.env`). Every process reads this file
# through @pretoscop/config/env (zod-validated); defaults below are for local development.

# --- General -------------------------------------------------------------------------------
# dev | test | staging | prod. Outside dev, the secrets below must be changed.
APP_ENV=dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs in a terminal (keep false in production: logs are JSON).
LOG_PRETTY=false

# --- Database (PostgreSQL 18) --------------------------------------------------------------
DATABASE_URL=postgres://pretoscop:pretoscop@localhost:5432/pretoscop
DATABASE_POOL_MAX=10
# Admin connection used by integration tests to create and drop throwaway databases.
TEST_DATABASE_ADMIN_URL=postgres://pretoscop:pretoscop@localhost:5432/postgres

# --- Public site ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
# Where the worker reaches the web app for cache revalidation (empty = PUBLIC_BASE_URL). A
# comma-separated list notifies every replica (production compose sets http://web-1:3000,http://web-2:3000).
WEB_INTERNAL_URL=
# false = every page is noindex (staging, prototype). Set true only for the public launch.
SITE_INDEXABLE=false

# --- Search (Meilisearch) ------------------------------------------------------------------
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# --- Crawler identity and politeness -------------------------------------------------------
# The User-Agent is fixed in code: Mozilla/5.0 (compatible; PretoscopBot/1.0; +<BOT_INFO_URL>)
BOT_INFO_URL=https://pretoscop.ro/bot
# Global switch for any request to a shop. Per-source switches live in the database.
CRAWL_ENABLED=false
# Minimum interval between two requests to the same domain (ms). Never below 5000 by default.
FETCH_DEFAULT_MIN_INTERVAL_MS=5000
FETCH_TIMEOUT_MS=30000
FETCH_MAX_BODY_BYTES=15728640

# --- Assisted-access channel (M05B, ADR-015; designated shops only) ------------------------
# none | zyte | oxylabs. "none" keeps the channel off even for shops with access_mode=assisted.
ASSISTED_VENDOR=none
ZYTE_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Hard monthly stop for vendor spend, in EUR, enforced in packages/fetch before every call (alert at 80%).
# Also set a spend limit in the vendor's dashboard (second line of defence).
ASSISTED_MONTHLY_CAP_EUR=150
# EUR per USD used to estimate Zyte's USD prices (rounded up: the ledger errs on the high side).
ASSISTED_EUR_PER_USD=0.9
ZYTE_API_URL=https://api.zyte.com/v1/extract

# --- Blob storage (raw snapshots, images, backups) -----------------------------------------
# fs (local directory) | s3 (Cloudflare R2 or any S3-compatible store)
BLOB_DRIVER=fs
BLOB_FS_ROOT=./data/blobs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---------------------------------------------------------------------------------
# smtp (Mailpit locally on :1025, UI on http://localhost:8025) | resend | log
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM=Pretoscop <noreply@pretoscop.ro>
MAIL_REPLY_TO=contact@pretoscop.ro
# Sender identity printed in every email (Law 506/2004, alerts).
COMPANY_LEGAL_NAME=Pretoscop (în curs de înființare)
COMPANY_POSTAL_ADDRESS=România

# --- Auth, admin and web internals ---------------------------------------------------------
# Long random strings outside dev: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=
# Shared secret for the worker → web cache-revalidation endpoint.
REVALIDATE_TOKEN=dev-only-insecure-secret-change-me
# Secret from which the daily rotating salt for IP/UA hashing is derived.
HASH_SALT_SECRET=dev-only-insecure-secret-change-me

# --- Operations alerts (source failures, backups, caps, SLO breaches) ----------------------
# Telegram bot (BotFather) and the founders' chat; also read by the pgbackrest sidecar.
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
# Comma-separated addresses; sent through MAIL_DRIVER (Resend in production).
OPS_ALERT_EMAIL=
# Dead-man's switches (Better Stack heartbeats or healthchecks.io): a missing ping is the alert.
# Worker alive (pinged every 5 min by the ops.heartbeat job):
OPS_HEARTBEAT_URL=
# Nightly logical dump (pg_dump → blob store) finished; <url>/fail is pinged on failure:
DUMP_HEARTBEAT_URL=

# --- LLM (M22) -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MONTHLY_CAP_EUR=50
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_ESCALATION=claude-sonnet-5-5

# --- Icecat (M11) --------------------------------------------------------------------------
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=

# --- Affiliate networks (M24) --------------------------------------------------------------
TWOPERFORMANT_EMAIL=
TWOPERFORMANT_PASSWORD=
TWOPERFORMANT_UNIQUE_CODE=
PROFITSHARE_API_USER=
PROFITSHARE_API_KEY=

# --- Analytics and monitoring --------------------------------------------------------------
# Build-time (inlined into the page): Plausible loads only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Base URL of licensed product images (R2 public domain); /media serves them from the blob store in dev.
NEXT_PUBLIC_MEDIA_BASE_URL=
SENTRY_DSN=
METRICS_PORT=9464

# --- Deployment (M18; read by docker compose and the scripts on the server, not by the app) --
# Each environment's checkout (/srv/pretoscop/prod, /srv/pretoscop/staging) has its own .env.
# prod | staging (deploy.sh refuses a mismatch with the environment it is asked to deploy).
DEPLOY_ENV=prod
# Registry and namespace of the images (GitHub Container Registry in production; lower-case owner).
IMAGE_REGISTRY=ghcr.io/owner
# Set by infra/scripts/deploy.sh for each release; do not set it here.
# IMAGE_TAG=
POSTGRES_IMAGE_TAG=18
# Database superuser password (hex, URL-safe): `openssl rand -hex 24`. DATABASE_URL is built from
# it by the compose file inside the stack.
POSTGRES_PASSWORD=
# PostgreSQL memory (production on 64 GB RAM: 16GB / 48GB / 64MB / 2GB; staging: 1GB / 3GB / 32MB / 256MB).
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_SHM_SIZE=1g
# on in production (WAL to the pgBackRest repository); off in staging. on requires BACKUPS_ENABLED=true.
PG_ARCHIVE_MODE=on
# Base backups, weekly restore test and WAL archiving through the pgbackrest sidecar (ADR-016);
# repository credentials live in .env.backup (template: infra/env/backup.env.example).
BACKUPS_ENABLED=true
# Daily backup time (Europe/Bucharest); ISO weekday of the full backup and of the restore test (7 = Sunday).
BACKUP_AT=02:30
BACKUP_FULL_DOW=7
RESTORE_TEST_DOW=7
# Heartbeats pinged by the sidecar after each base backup and each restore test.
BACKUP_HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=
# Memory caps per container.
WEB_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=2g
MEILI_MEMORY_LIMIT=4g
# Optional compose profiles: monitoring (Grafana Alloy → Grafana Cloud).
COMPOSE_PROFILES=
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_KEY=
# Edge stack (Caddy; started from the production checkout).
EDGE_NETWORK=pretoscop-edge
SITE_DOMAIN=pretoscop.ro
STAGING_DOMAIN=staging.pretoscop.ro
# TLS: "/etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key" (Cloudflare Origin CA, recommended),
# an email address (automatic Let's Encrypt), or "internal" (local runs only).
CADDY_TLS=/etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
ACME_EMAIL=admin@pretoscop.ro
