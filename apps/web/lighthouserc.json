{
  "ci": {
    "collect": {
      "url": ["http://localhost:3200/", "http://localhost:3200/despre", "http://localhost:3200/c/tv-audio/televizoare"],
      "numberOfRuns": 1,
      "settings": { "formFactor": "mobile", "throttlingMethod": "simulate" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 153600 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 600000 }]
      }
    }
  }
}
