# Pretoscop environment. Copy to `.env` (never commit `.env`). Every process reads this file
# through @pretoscop/config/env (zod-validated); defaults below are for local development.

# --- General -------------------------------------------------------------------------------
# dev | test | staging | prod. Outside dev, the secrets below must be changed.
APP_ENV=dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs in a terminal (keep false in production: logs are JSON).
LOG_PRETTY=false

# --- Database (PostgreSQL 18) --------------------------------------------------------------
DATABASE_URL=postgres://pretoscop:pretoscop@localhost:5432/pretoscop
DATABASE_POOL_MAX=10
# Admin connection used by integration tests to create and drop throwaway databases.
TEST_DATABASE_ADMIN_URL=postgres://pretoscop:pretoscop@localhost:5432/postgres

# --- Public site ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
# Where the worker reaches the web app for cache revalidation (empty = PUBLIC_BASE_URL).
WEB_INTERNAL_URL=
# false = every page is noindex (staging, prototype). Set true only for the public launch.
SITE_INDEXABLE=false

# --- Search (Meilisearch) ------------------------------------------------------------------
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# --- Crawler identity and politeness -------------------------------------------------------
# The User-Agent is fixed in code: Mozilla/5.0 (compatible; PretoscopBot/1.0; +<BOT_INFO_URL>)
BOT_INFO_URL=https://pretoscop.ro/bot
# Fixed crawler egress IPs published on /bot and /bot/ips.json: comma-separated IPv4/IPv6
# addresses or CIDR prefixes, e.g. 203.0.113.10,2001:db8::/64. Leave empty until the dedicated
# crawler IPs exist (setup A4); an invalid entry stops every process at startup. When the list
# changes, add a changelog entry on /bot (apps/web/src/lib/bot-policy.ts: BOT_CHANGELOG).
BOT_EGRESS_IPS=
# Global switch for any request to a shop. Per-source switches live in the database.
CRAWL_ENABLED=false
# Minimum interval between two requests to the same domain (ms). Never below 5000 by default.
FETCH_DEFAULT_MIN_INTERVAL_MS=5000
FETCH_TIMEOUT_MS=30000
FETCH_MAX_BODY_BYTES=15728640
# The worker's fetcher refuses private, loopback and link-local addresses (merchants type feed
# URLs into the portal, M20). true only for local fixture servers in development and e2e;
# refused at startup when APP_ENV is staging or prod.
FETCH_ALLOW_PRIVATE_HOSTS=false

# Web Bot Auth (M21; infra/bot-program/web-bot-auth.md). WEB_BOT_AUTH=true makes the fetcher sign
# every request (RFC 9421, Ed25519, Signature-Agent = origin of BOT_INFO_URL). The web app serves
# the public key at /.well-known/http-message-signatures-directory whenever the key is set, so
# publish the key (and register it) before switching signing on. The key is a SECRET: generate it
# with `pnpm --filter @pretoscop/fetch bot-auth:keygen`, keep it only in the server environment of
# both the worker and the web app, never in git.
WEB_BOT_AUTH=false
WEB_BOT_AUTH_PRIVATE_KEY=

# --- Assisted-access channel (M05B, ADR-015; designated shops only) ------------------------
# none | zyte | oxylabs. "none" keeps the channel off even for shops with access_mode=assisted.
ASSISTED_VENDOR=none
ZYTE_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Hard monthly stop for vendor spend, in EUR (warning at 80%).
ASSISTED_MONTHLY_CAP_EUR=150

# --- Blob storage (raw snapshots, images, backups) -----------------------------------------
# fs (local directory) | s3 (Cloudflare R2 or any S3-compatible store)
BLOB_DRIVER=fs
BLOB_FS_ROOT=./data/blobs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---------------------------------------------------------------------------------
# smtp (Mailpit locally on :1025, UI on http://localhost:8025) | resend | log
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM=Pretoscop <noreply@pretoscop.ro>
MAIL_REPLY_TO=contact@pretoscop.ro
# Sender identity printed in every email (Law 506/2004, alerts).
COMPANY_LEGAL_NAME=Pretoscop (în curs de înființare)
COMPANY_POSTAL_ADDRESS=România

# --- Auth, admin and web internals ---------------------------------------------------------
# Long random strings outside dev: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=
# Shared secret for the worker → web cache-revalidation endpoint.
REVALIDATE_TOKEN=dev-only-insecure-secret-change-me
# Secret from which the daily rotating salt for IP/UA hashing is derived.
HASH_SALT_SECRET=dev-only-insecure-secret-change-me

# --- Operations alerts (source failures, backups, caps) ------------------------------------
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
OPS_ALERT_EMAIL=

# --- LLM (M22) -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MONTHLY_CAP_EUR=50
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_ESCALATION=claude-sonnet-5-5

# --- Icecat (M11) --------------------------------------------------------------------------
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=

# --- Affiliate networks (M24) --------------------------------------------------------------
TWOPERFORMANT_EMAIL=
TWOPERFORMANT_PASSWORD=
TWOPERFORMANT_UNIQUE_CODE=
PROFITSHARE_API_USER=
PROFITSHARE_API_KEY=

# --- Analytics and monitoring --------------------------------------------------------------
# Build-time (inlined into the page): Plausible loads only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Base URL of licensed product images (R2 public domain); /media serves them from the blob store in dev.
NEXT_PUBLIC_MEDIA_BASE_URL=
SENTRY_DSN=
METRICS_PORT=9464
