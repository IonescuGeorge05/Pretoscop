# Pretoscop environment. Copy to `.env` (never commit `.env`). Every process reads this file
# through @pretoscop/config/env (zod-validated); defaults below are for local development.

# --- General -------------------------------------------------------------------------------
# dev | test | staging | prod. Outside dev, the secrets below must be changed.
APP_ENV=dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs in a terminal (keep false in production: logs are JSON).
LOG_PRETTY=false

# --- Database (PostgreSQL 18) --------------------------------------------------------------
DATABASE_URL=postgres://pretoscop:pretoscop@localhost:5432/pretoscop
DATABASE_POOL_MAX=10
# Admin connection used by integration tests to create and drop throwaway databases.
TEST_DATABASE_ADMIN_URL=postgres://pretoscop:pretoscop@localhost:5432/postgres

# --- Public site ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
# Where the worker reaches the web app for cache revalidation (empty = PUBLIC_BASE_URL). A
# comma-separated list notifies every replica (production compose sets http://web-1:3000,http://web-2:3000).
WEB_INTERNAL_URL=
# false = every page is noindex (staging, prototype). Set true only for the public launch.
SITE_INDEXABLE=false

# --- Search (Meilisearch) ------------------------------------------------------------------
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# --- Crawler identity and politeness -------------------------------------------------------
# The User-Agent is fixed in code: Mozilla/5.0 (compatible; PretoscopBot/1.0; +<BOT_INFO_URL>)
BOT_INFO_URL=https://pretoscop.ro/bot
# Fixed crawler egress IPs published on /bot and /bot/ips.json: comma-separated IPv4/IPv6
# addresses or CIDR prefixes, e.g. 203.0.113.10,2001:db8::/64. Leave empty until the dedicated
# crawler IPs exist (setup A4); an invalid entry stops every process at startup. When the list
# changes, add a changelog entry on /bot (apps/web/src/lib/bot-policy.ts: BOT_CHANGELOG).
BOT_EGRESS_IPS=
# Global switch for any request to a shop. Per-source switches live in the database.
CRAWL_ENABLED=false
# Minimum interval between two requests to the same domain (ms). Never below 5000 by default.
FETCH_DEFAULT_MIN_INTERVAL_MS=5000
FETCH_TIMEOUT_MS=30000
FETCH_MAX_BODY_BYTES=15728640
# The worker's fetcher refuses private, loopback and link-local addresses (merchants type feed
# URLs into the portal, M20). true only for local fixture servers in development and e2e;
# refused at startup when APP_ENV is staging or prod.
FETCH_ALLOW_PRIVATE_HOSTS=false
# Narrower alternative for e2e: exact ip:port fixture servers the guard lets through (e.g. 127.0.0.1:3399).
FETCH_PRIVATE_ALLOWLIST=

# --- Assisted-access channel (M05B, ADR-015, ADR-022; designated shops only) ---------------
# none | zyte | oxylabs. "none" keeps the channel off even for shops with access_mode=assisted.
ASSISTED_VENDOR=none
ZYTE_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Hard monthly stop for vendor spend, in EUR: every call is booked before it is sent and refused if
# the month would pass it (packages/fetch; alert at 80%).
# Also set a spend limit in the vendor's dashboard (second line of defence).
ASSISTED_MONTHLY_CAP_EUR=150
# EUR per USD used to estimate Zyte's USD prices (rounded up: the ledger errs on the high side).
ASSISTED_EUR_PER_USD=0.9
# Zyte API endpoint: https only (http only for a local mock on 127.0.0.1/localhost in development).
ZYTE_API_URL=https://api.zyte.com/v1/extract

# --- Blob storage (raw snapshots, images, backups) -----------------------------------------
# fs (local directory) | s3 (Cloudflare R2 or any S3-compatible store)
BLOB_DRIVER=fs
BLOB_FS_ROOT=./data/blobs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---------------------------------------------------------------------------------
# smtp (Mailpit locally on :1025, UI on http://localhost:8025) | resend | log
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM=Pretoscop <noreply@pretoscop.ro>
MAIL_REPLY_TO=contact@pretoscop.ro
# Sender identity printed in every email (Law 506/2004 art. 12, Law 365/2002, alerts). The values
# below are dev placeholders: with APP_ENV=prod every process refuses to start until both name the
# real operator (legal name; full postal address); APP_ENV=staging logs a warning. Launch
# prerequisite: the SRL's registered name and address (docs/09 B4; infra/launch-checklist.md).
COMPANY_LEGAL_NAME=Pretoscop (în curs de înființare)
COMPANY_POSTAL_ADDRESS=România

# --- Auth, admin and web internals ---------------------------------------------------------
# Long random strings outside dev: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=
# Shared secret for the worker → web cache-revalidation endpoint.
REVALIDATE_TOKEN=dev-only-insecure-secret-change-me
# Secret from which the daily rotating salt for IP/UA hashing is derived. Keep it: consent
# evidence (alerts) stores daily-salted IP hashes that can only be checked with this secret.
HASH_SALT_SECRET=dev-only-insecure-secret-change-me

# --- Price alerts (M19) --------------------------------------------------------------------
# Signs the confirmation and unsubscribe links in alert emails and keys the stable address hash
# of the suppression list and the consent ledger. Long random string outside dev
# (`openssl rand -base64 32`); rotating it breaks every link already sent and every stored hash.
ALERTS_SECRET=dev-only-insecure-secret-change-me
# Resend webhook signing secret (whsec_…, Resend → Webhooks; events email.bounced and
# email.complained → https://pretoscop.ro/api/webhooks/resend). Empty = the endpoint answers 404.
# Required with APP_ENV=prod and MAIL_DRIVER=resend (a complaint must stop the alerts): the
# processes refuse to start without it; APP_ENV=staging logs a warning. Launch prerequisite (B2).
RESEND_WEBHOOK_SECRET=

# --- Operations alerts (source failures, backups, caps, SLO breaches) ----------------------
# Telegram bot (BotFather) and the founders' chat; also read by the pgbackrest sidecar.
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
# Comma-separated addresses; sent through MAIL_DRIVER (Resend in production).
OPS_ALERT_EMAIL=
# Dead-man's switches (Better Stack heartbeats or healthchecks.io): a missing ping is the alert.
# Worker alive (pinged every 5 min by the ops.heartbeat job):
OPS_HEARTBEAT_URL=
# Nightly logical dump (pg_dump → blob store) finished; <url>/fail is pinged on failure:
DUMP_HEARTBEAT_URL=

# --- LLM (M22) -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MONTHLY_CAP_EUR=50
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_ESCALATION=claude-sonnet-5-5

# --- Icecat (M11) --------------------------------------------------------------------------
# Open Icecat account name (docs/09 B1), sent as `shopname`; Open Icecat needs no token. The
# icecat.sync job also needs the database flag `icecat.enabled` (off by default).
ICECAT_USERNAME=
# Full Icecat only (not used by the Open Icecat client).
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
# Live JSON API; tests and `icecat:lookup --mock` use a local stand-in instead.
ICECAT_BASE_URL=https://live.icecat.biz/api
# Languages tried in order (the first with content is stored).
ICECAT_LANGS=RO,EN
# Datasheet requests per language per month (Fair Use Policy: 1,000,000; excess is billable).
ICECAT_MONTHLY_CAP=1000000
# Products looked up per daily run (new first, then 30-day refreshes).
ICECAT_DAILY_BATCH=2000
# Minimum interval between two requests to an Icecat host, in ms (Icecat allows 100/s).
ICECAT_MIN_INTERVAL_MS=1000

# --- Affiliate networks (M24) --------------------------------------------------------------
TWOPERFORMANT_EMAIL=
TWOPERFORMANT_PASSWORD=
# Our 2Performant affiliate code (aff_code in quicklinks).
TWOPERFORMANT_UNIQUE_CODE=
TWOPERFORMANT_API_URL=https://api.2performant.com
PROFITSHARE_API_USER=
PROFITSHARE_API_KEY=
# Publisher ids for the other networks' deep links (M24); empty = plain links for their programs.
AWIN_PUBLISHER_ID=
CJ_PUBLISHER_ID=
TRADEDOUBLER_AFFILIATE_ID=

# --- Analytics and monitoring --------------------------------------------------------------
# Build-time (inlined into the page): Plausible loads only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Base URL of licensed product images (R2 public domain); /media serves them from the blob store in dev.
NEXT_PUBLIC_MEDIA_BASE_URL=
SENTRY_DSN=
METRICS_PORT=9464

# --- Deployment (M18; read by docker compose and the scripts on the server, not by the app) --
# Each environment's checkout (/srv/pretoscop/prod, /srv/pretoscop/staging) has its own .env.
# prod | staging (deploy.sh refuses a mismatch with the environment it is asked to deploy).
DEPLOY_ENV=prod
# Registry and namespace of the images (GitHub Container Registry in production; lower-case owner).
IMAGE_REGISTRY=ghcr.io/owner
# Set by infra/scripts/deploy.sh for each release; do not set it here.
# IMAGE_TAG=
# Database image (PostgreSQL 18 + pgBackRest): 18 is the newest build, 18-<release tag> pins one. A new
# image is applied only by RECREATE_DATA_SERVICES=1 deploy.sh (infra/runbooks/deploy.md).
POSTGRES_IMAGE_TAG=18
# Database superuser password (hex, URL-safe): `openssl rand -hex 24`. DATABASE_URL is built from
# it by the compose file inside the stack.
POSTGRES_PASSWORD=
# PostgreSQL memory (production on 64 GB RAM: 16GB / 48GB / 64MB / 2GB; staging: 1GB / 3GB / 32MB / 256MB).
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_SHM_SIZE=1g
# on in production (WAL to the pgBackRest repository); off in staging. on requires BACKUPS_ENABLED=true.
PG_ARCHIVE_MODE=on
# Base backups, weekly restore test and WAL archiving through the pgbackrest sidecar (ADR-018);
# repository credentials live in .env.backup (template: infra/env/backup.env.example).
BACKUPS_ENABLED=true
# Daily backup time (Europe/Bucharest); ISO weekday of the full backup and of the restore test (7 = Sunday).
BACKUP_AT=02:30
BACKUP_FULL_DOW=7
RESTORE_TEST_DOW=7
# Heartbeats pinged by the sidecar after each base backup and each restore test.
BACKUP_HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=
# Memory caps per container.
WEB_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=2g
MEILI_MEMORY_LIMIT=4g
# Optional compose profiles, comma-separated: monitoring (Grafana Alloy → Grafana Cloud), analytics
# (self-hosted Plausible, production only; then build the prod web image with
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://<PLAUSIBLE_DOMAIN>/js/script.js and NEXT_PUBLIC_PLAUSIBLE_DOMAIN).
COMPOSE_PROFILES=
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_KEY=
# Plausible (profile analytics): its host name, the database password (`openssl rand -hex 24`) and
# SECRET_KEY_BASE (`openssl rand -base64 48`); invite_only after the founders have registered.
PLAUSIBLE_DOMAIN=stats.pretoscop.ro
PLAUSIBLE_DB_PASSWORD=
PLAUSIBLE_SECRET_KEY_BASE=
PLAUSIBLE_DISABLE_REGISTRATION=invite_only
# Edge stack (Caddy; started from the production checkout).
EDGE_NETWORK=pretoscop-edge
SITE_DOMAIN=pretoscop.ro
STAGING_DOMAIN=staging.pretoscop.ro
# TLS: "/etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key" (Cloudflare Origin CA, recommended),
# an email address (automatic Let's Encrypt), or "internal" (local runs only).
CADDY_TLS=/etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
ACME_EMAIL=admin@pretoscop.ro

# --- Local verification (read by scripts/verify and Playwright, not by the apps) ------------
# Port of the web server the verify scripts and e2e tests start (default 3200). Give each
# parallel checkout (git worktree) its own, with its own DATABASE_URL and METRICS_PORT.
# E2E_PORT=3200
