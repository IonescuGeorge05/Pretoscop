{
  "title": "Pretoscop — operations",
  "uid": "pretoscop-ops",
  "tags": ["pretoscop"],
  "timezone": "Europe/Bucharest",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "env",
        "type": "custom",
        "query": "prod,staging",
        "current": { "text": "prod", "value": "prod" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Offers observed within 26 h (SLO ≥ 95%)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.9 }, { "color": "green", "value": 0.95 }] }
        }
      },
      "targets": [{ "expr": "sum(pretoscop_offers_checked_26h{env=\"$env\"}) / sum(pretoscop_offers_active{env=\"$env\"})", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live sources past their SLO",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        {
          "expr": "count((pretoscop_source_last_success_age_seconds{env=\"$env\"} > on (source) group_left () (pretoscop_source_freshness_slo_seconds{env=\"$env\"} + 7200)) and on (source) (pretoscop_source_live{env=\"$env\"} == 1)) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Price events, last 24 h",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "pretoscop_price_events_24h{env=\"$env\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hours since the last nightly dump / base backup WAL",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "h", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 26 }] } } },
      "targets": [
        { "expr": "(time() - pretoscop_job_last_success_timestamp_seconds{env=\"$env\", queue=\"backup.nightly\"}) / 3600", "legendFormat": "pg_dump", "refId": "A" },
        { "expr": "(time() - pretoscop_pg_last_archived_timestamp_seconds{env=\"$env\"}) / 3600", "legendFormat": "last WAL archived", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Sources: age of the last success vs SLO (hours)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "pretoscop_source_last_success_age_seconds{env=\"$env\"} / 3600 and on (source) (pretoscop_source_live{env=\"$env\"} == 1)", "format": "table", "instant": true, "refId": "A" },
        { "expr": "pretoscop_source_freshness_slo_seconds{env=\"$env\"} / 3600 and on (source) (pretoscop_source_live{env=\"$env\"} == 1)", "format": "table", "instant": true, "refId": "B" }
      ],
      "transformations": [{ "id": "merge" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Source runs per day by status",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (status) (pretoscop_ingest_runs_24h{env=\"$env\"})", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queues (waiting, running, failed 24 h)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (queue, state) (pretoscop_queue_jobs{env=\"$env\"})", "legendFormat": "{{queue}} {{state}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Match review queue and quarantine",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "pretoscop_review_queue_offers{env=\"$env\"}", "legendFormat": "review queue", "refId": "A" },
        { "expr": "pretoscop_quarantine_pending{env=\"$env\"}", "legendFormat": "quarantine", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Origin requests per second by status (Caddy)",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (code) (rate(caddy_http_requests_total{job=\"caddy\"}[5m]))", "legendFormat": "{{code}}", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Origin latency p95 (Caddy, seconds)",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, host) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\"}[5m])))", "legendFormat": "{{host}}", "refId": "A" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker memory and event loop",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"pretoscop-worker\", env=\"$env\"}", "legendFormat": "RSS bytes", "refId": "A" },
        { "expr": "nodejs_eventloop_delay_p99_seconds{job=\"pretoscop-worker\", env=\"$env\"}", "legendFormat": "event loop p99 s", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk free and database size",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "pretoscop_disk_free_bytes{env=\"$env\"}", "legendFormat": "disk free", "refId": "A" },
        { "expr": "pretoscop_pg_database_size_bytes{env=\"$env\"}", "legendFormat": "database", "refId": "B" }
      ]
    }
  ]
}
