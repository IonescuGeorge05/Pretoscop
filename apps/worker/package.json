{
  "name": "@pretoscop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "shops:sync": "tsx src/cli/shops-sync.ts",
    "run:source": "tsx src/cli/run-source.ts",
    "replay": "tsx src/cli/replay.ts",
    "backup": "tsx src/cli/backup.ts",
    "stats:show": "tsx src/cli/stats-show.ts",
    "match:run": "tsx src/cli/match-run.ts",
    "match:eval": "tsx src/cli/match-eval.ts",
    "match:eval:build": "tsx src/cli/match-eval-build.ts",
    "match:label": "tsx src/cli/match-label.ts",
    "compare:live": "tsx src/cli/compare-live.ts",
    "report": "tsx src/cli/report.ts",
    "report:approve": "tsx src/cli/report-approve.ts",
    "alerts:simulate": "tsx src/cli/alerts-simulate.ts",
    "alerts:run": "tsx src/cli/alerts-run.ts",
    "icecat:lookup": "tsx src/cli/icecat-lookup.ts",
    "icecat:coverage": "tsx src/cli/icecat-coverage.ts",
    "icecat:sync": "tsx src/cli/icecat-sync.ts",
    "icecat:demo": "tsx src/cli/icecat-demo.ts",
    "renormalize": "tsx src/cli/renormalize.ts",
    "commissions:import": "tsx src/cli/commissions-import.ts",
    "bot:check": "tsx src/cli/bot-check.ts",
    "shops:probe": "tsx src/cli/shops-probe.ts"
