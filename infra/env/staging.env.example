# Staging overrides (M18). Start from the repository's .env.example in /srv/pretoscop/staging/.env
# and set these values; everything else as in production, with its own secrets.
# Staging runs on the production server under the compose project `pretoscop-staging`, behind
# Cloudflare Access, never indexed, never crawling and never emailing anyone.
APP_ENV=staging
DEPLOY_ENV=staging
PUBLIC_BASE_URL=https://staging.pretoscop.ro
SITE_INDEXABLE=false
# Never crawl from staging: same IP as production, it would halve the politeness budget.
CRAWL_ENABLED=false
# Never email real people from staging.
MAIL_DRIVER=log
ASSISTED_VENDOR=none
# Own secrets: generate new ones, never copy production's.
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
BETTER_AUTH_SECRET=
REVALIDATE_TOKEN=
HASH_SALT_SECRET=
# Own blob prefix or bucket (snapshots and dumps of staging never mix with production).
S3_BUCKET=pretoscop-staging
# No WAL archive and no base backups for staging (its data is disposable).
PG_ARCHIVE_MODE=off
BACKUPS_ENABLED=false
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB
WEB_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=1g
MEILI_MEMORY_LIMIT=1g
# Heartbeats and alerts: leave the production URLs out (or use separate staging monitors).
OPS_HEARTBEAT_URL=
DUMP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=
