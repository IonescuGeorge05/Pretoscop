# Copiază în .env și ajustează. Niciun secret real nu se commite.

# Numele aplicației — singurul loc unde se schimbă (UI, title/meta, User-Agent, nume containere)
APP_NAME=Pretoscop
APP_SLUG=pretoscop

# PostgreSQL
POSTGRES_USER=pretoscop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pretoscop
DATABASE_URL=postgresql+psycopg://pretoscop:change-me@db:5432/pretoscop

# Token pentru POST /api/admin/scrape (header X-Admin-Token)
ADMIN_TOKEN=change-me-too

# Ce date afișează UI-ul implicit: mock | real
# (se poate suprascrie per cerere cu ?source=real / ?source=mock)
DATA_MODE=mock

# Scraping (worker)
SCRAPING_ENABLED=true
SCRAPE_INTERVAL_HOURS=6
SCRAPE_JITTER_MINUTES=30
# adresa de contact a robotului, afișată pe pagina /bot (o adresă dedicată proiectului, nu una personală)
SCRAPER_CONTACT=contact@example.com
# Cine operează site-ul, afișat pe /termeni (ex. numele tău sau „Nume PFA”). Gol = „proiect personal”.
OPERATOR_NAME=

# Alerte OLX pe email (opțional). Pe olx.ro: salvezi căutarea (ex. „ps5”) cu notificări pe email.
# Parola = „parolă pentru aplicații” (Gmail: verificare în 2 pași -> Parole pentru aplicații;
# Yahoo: Securitatea contului -> Generează parolă pentru aplicații). Nu parola obișnuită.
# IMAP_HOST gol = dedus din adresă (gmail, yahoo, outlook, icloud)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
OLX_ALERT_SENDER=olx.ro

# Căutare web prin Brave Search API (opțional): anunțuri OLX din indexul motorului + descoperire de magazine.
# Cheie gratuită (credit lunar ~1000 de căutări, cere card): https://brave.com/search/api/
BRAVE_API_KEY=

# Alerte de preț pe email trimise de site (opțional; gol = formularul spune că alertele pornesc la lansare).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER = adresa, SMTP_PASSWORD = „parolă pentru aplicații”.
# Recomandat: o adresă dedicată proiectului, nu cea personală.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# adresa publică a site-ului (linkurile de confirmare / dezabonare din emailuri)
PUBLIC_SITE_URL=http://localhost:3000
# 1 = paginile cer să NU fie indexate de Google (până la lansare); pune 0 la lansare
NOINDEX=1
# adresa ta personală: primești un email când un magazin ne blochează / își revine sau un scraper cade
OWNER_EMAIL=

# Frontend -> API (rețea internă docker)
API_INTERNAL_URL=http://api:8000
