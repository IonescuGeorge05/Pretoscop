  "devDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "dependencies": {
    "@pretoscop/config": "workspace:*",
    "@pretoscop/core": "workspace:*",
    "@pretoscop/db": "workspace:*",
    "@pretoscop/extractors": "workspace:*",
    "@pretoscop/fetch": "workspace:*",
    "@pretoscop/icecat": "workspace:*",
    "@pretoscop/mailer": "workspace:*",
    "@pretoscop/notify": "workspace:*",
    "@pretoscop/report": "workspace:*",
    "@pretoscop/storage": "workspace:*",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "0.45.4",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "sharp": "0.35.5"
  }
