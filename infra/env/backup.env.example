# pgBackRest repository settings (ADR-017). Copy to `.env.backup` next to the production `.env`
# (never commit it; `.env.*` is git-ignored). Read only by the `postgres` container (WAL
# archive-push) and the `pgbackrest` sidecar (backups, restore test), never by web or worker.
#
# Cloudflare R2: a dedicated bucket (e.g. pretoscop-backups) and an API token limited to it
# (Object Read & Write). Endpoint: <ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/pgbackrest/prod
PGBACKREST_REPO1_S3_BUCKET=pretoscop-backups
PGBACKREST_REPO1_S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_REGION=auto
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_S3_URI_STYLE=path

# Two weekly full backups (+ daily differentials and continuous WAL): about 14 days of
# point-in-time recovery. Raise to 4 for a month once the bucket cost is known.
PGBACKREST_REPO1_RETENTION_FULL=2

# Client-side encryption: R2 never sees the data in clear. KEEP THIS PASSPHRASE OUTSIDE THE
# SERVER TOO (both founders' password managers): without it the backups cannot be restored.
# `openssl rand -base64 48`
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=

PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_START_FAST=y
PGBACKREST_PROCESS_MAX=2
